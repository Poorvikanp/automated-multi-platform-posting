# Copy to .env and fill in. Never commit .env.
# A platform with missing credentials is reported as "failed" and the others still run.

# Mastodon: Settings > Development > New application (scope: write:statuses)
MASTODON_INSTANCE=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# Bluesky: Settings > Privacy and security > App passwords
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_APP_PASSWORD=
# BLUESKY_SERVICE=https://bsky.social

# DEV Community: Settings > Extensions > Generate API key
DEVTO_API_KEY=

# GitHub: fine-grained or classic token with "gist" scope
GITHUB_TOKEN=

# Telegram: create a bot with @BotFather, make a PUBLIC channel, add bot as admin
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@your_public_channel
